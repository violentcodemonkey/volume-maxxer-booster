{
  "manifest_version": 3,
  "name": "Volume Maxer & Booster",
  "description": "Adjust the audio level of the current tab with a conservative 200% limit.",
  "version": "1.0.0",
  "action": {
    "default_title": "Volume Maxer & Booster",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabCapture", "offscreen", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
